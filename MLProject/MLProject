name: titanic-mlproject-devin-novansyah

conda_env: conda.yaml

entry_points:
  main:
    command: "python modelling.py --n_estimators {n_estimators} --max_depth {max_depth} --min_samples_split {min_samples_split} --max_features {max_features} --test_size {test_size} --random_state {random_state}"
    parameters:
      n_estimators:
        type: int
        default: 100
      max_depth:
        type: int
        default: 6
      min_samples_split:
        type: int
        default: 2
      max_features:
        type: str
        default: "sqrt"
      test_size:
        type: float
        default: 0.2
      random_state:
        type: int
        default: 42
